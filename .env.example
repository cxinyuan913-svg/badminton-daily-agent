# 複製成 .env 後填入。.env 不進版控。
DATABASE_PATH=data/brief.db

# Discord：伺服器頻道設定 → 整合 → Webhook
DISCORD_WEBHOOK_DAILY=
DISCORD_WEBHOOK_ALERTS=
# 腳本專用頻道（notes 10:25）
DISCORD_WEBHOOK_SCRIPTS=

# LLM（已決議使用雲端 API）
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 台北時間一天的 LLM 預算（US$），超過就跳過腳本、推告警（日報照跑）
LLM_DAILY_BUDGET_USD=1.0

# 爬蟲
REQUEST_GAP_SEC=2.0

# 腳本推送開關（1 = 推到 DISCORD_WEBHOOK_SCRIPTS；預設只寫檔 data/scripts/）
SCRIPT_DAILY=
SCRIPT_FINAL=
SCRIPT_WEEKLY=
